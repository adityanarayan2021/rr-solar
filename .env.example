# ---------- Database (required to store leads) ----------
# MongoDB Atlas free tier: https://cloud.mongodb.com  (M0 cluster, no card needed)
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="rrsolar"

# ---------- Email notifications (optional but recommended) ----------
# Resend free tier: 3,000 emails/month, 100/day — https://resend.com
RESEND_API_KEY=""
# Must be a verified domain in Resend once DNS is set up:
MAIL_FROM="RR Solar Solutions <noreply@rrsolarsolutions.in>"
LEAD_NOTIFY_EMAIL="rrsolarsolutions2@gmail.com"
NOTIFY_TEAM="true"     # set to "false" to stop the internal alert email
AUTO_REPLY="true"      # set to "false" to stop the customer confirmation email

# ---------- Admin dashboard (/admin) ----------
ADMIN_PASSWORD="change-this-to-something-long"
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# ---------- Analytics (both completely free, both optional) ----------
# Google Analytics 4 — https://analytics.google.com  (Admin → Data Streams → Measurement ID)
NEXT_PUBLIC_GA_ID=""            # e.g. G-XXXXXXXXXX
# Microsoft Clarity — https://clarity.microsoft.com  (heatmaps + session recordings, free forever)
NEXT_PUBLIC_CLARITY_ID=""       # e.g. abcd1234ef
# Google Search Console HTML-tag verification token (optional)
NEXT_PUBLIC_GOOGLE_VERIFICATION=""

# ---------- Scheduled monthly report ----------
# Generate with: openssl rand -base64 32
# Vercel sends this as "Authorization: Bearer <value>" when triggering the cron.
CRON_SECRET=""
